# OmniKPI / PlantIntel — Environment Variables
# Copy this file to .env and fill in your values. Never commit .env to git.

# ── LLM Router (OpenRouter / NineRouter) ────────────────────────────────────
# Free-tier: use OpenRouter. Swap base_url to paid provider for CALIBER Final Stage.
OPENROUTER_API_KEY=sk-or-v1-YOUR_KEY_HERE
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model selection — justify for ITASE "alasan pemilihan teknologi" criterion:
#   - llama-3.1-70b-instruct: 128k context window (sufficient for shift log retrieval),
#     strong instruction-following for structured JSON output, low latency on free tier.
#   - Change to gpt-4o / claude-3-5-sonnet for CALIBER Final Stage paid fallback.
LLM_MODEL=meta-llama/llama-3.1-70b-instruct

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./omnikpi.db

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development          # development | production
CORS_ORIGINS=http://localhost:5173   # Vite dev server default port
